generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

// A suspended account keeps its data but cannot authenticate. middleware/auth.js
// re-reads the user on every request, so suspending takes effect immediately
// rather than when the token expires.
enum UserStatus {
  active
  suspended
}

enum SkillLevel {
  Beginner
  Intermediate
  Advanced
  Expert
}

enum BookingStatus {
  Requested
  Confirmed
  Completed
  Cancelled
}

enum BookingParty {
  learner
  teacher
  admin
}

enum TransactionType {
  Initial
  Lock
  Transfer
  Refund
  Adjustment
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  // bcrypt hash. Never leaves the server: lib/profile.js strips it, because it
  // spreads the whole user into the /auth/me and GET /profile responses.
  passwordHash  String?
  role          Role       @default(user)
  status        UserStatus @default(active)
  avatarUrl     String?
  name          String
  college       String?
  yearOfStudy   String?
  bio           String?
  creditBalance Int      @default(10)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  skillsToTeach  Skill[]
  skillsToLearn  SkillToLearn[]
  bookingsAsTeacher Booking[]     @relation("TeacherBookings")
  bookingsAsLearner Booking[]     @relation("LearnerBookings")
  transactions      Transaction[]
  reviewsWritten    Review[]      @relation("ReviewsWritten")
  reviewsReceived   Review[]      @relation("ReviewsReceived")
}

model Skill {
  id             String     @id @default(uuid())
  skillName      String
  level          SkillLevel
  creditsPerHour Int        @default(1)
  description    String
  // Meaning of the skill as a list of numbers, used for semantic search.
  // Prisma has no native vector type, so it is read and written with raw SQL;
  // see lib/embeddings.js and lib/skillSearch.js.
  embedding      Unsupported("vector(384)")?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  modules  SkillModule[]

  @@index([userId])
  @@index([skillName])
}

// The curriculum for a skill: an ordered list of what gets covered and how to
// work through it, the way a course page lists its sections. One row per
// module, so the content can be read, reordered and searched on its own rather
// than living inside Skill.description as one paragraph.
//
// Module text is part of the parent skill's embedding (lib/embeddings.js), so
// adding or removing one re-embeds the Skill.
model SkillModule {
  id        String   @id @default(uuid())
  title     String
  content   String
  // Each module carries its own vector rather than being folded into the
  // parent skill's. Concatenating them was measured and it diluted the skill:
  // a query matching one module scored worse than before modules existed. Same
  // Unsupported() caveat as Skill.embedding — never SELECT m.* in a raw query.
  embedding Unsupported("vector(384)")?
  // Order within the curriculum. Assigned on insert as (count so far), so
  // rows read back in the order they were added.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, position])
}

model SkillToLearn {
  id        String   @id @default(uuid())
  skillName String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([skillName])
}

model Booking {
  id                 String        @id @default(uuid())
  skill              String
  status             BookingStatus @default(Requested)
  creditAmount       Int
  dateTime           DateTime
  duration           Int           @default(1)
  completedByLearner Boolean       @default(false)
  completedByTeacher Boolean       @default(false)
  cancelledBy        BookingParty?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  teacherId String
  teacher   User   @relation("TeacherBookings", fields: [teacherId], references: [id])
  learnerId String
  learner   User   @relation("LearnerBookings", fields: [learnerId], references: [id])
  skillId   String?
  skillRef  Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  reviews      Review[]

  @@index([teacherId])
  @@index([learnerId])
  @@index([status])
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  amount      Int
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  skill     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewerId String
  reviewer   User    @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId String
  reviewee   User    @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, reviewerId])
  @@index([revieweeId])
}
